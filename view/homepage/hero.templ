package homepage

import "cv-website/model"

templ Hero(p model.Profile) {
	<section class="section-container pt-24 pb-12">
		<div class="flex flex-col sm:flex-row items-start gap-8">
			if p.Photo != "" {
				<div class="shrink-0">
					<img
						src={ p.Photo }
						alt={ p.Name }
						class="w-32 sm:w-36 h-auto rounded-md border border-border"
						fetchpriority="high"
						loading="eager"
					/>
				</div>
			}
			<div class="flex flex-col gap-3">
				<div class="flex items-center gap-2 font-mono text-muted-foreground text-sm">
					<span class="text-accent">$</span>
					<span>whoami</span>
				</div>
				<h1 class="text-2xl sm:text-3xl font-bold text-foreground">
					{ p.Name }
				</h1>
				<p class="text-muted-foreground leading-relaxed max-w-xl">
					{ p.Title }
				</p>
				<div class="flex items-center gap-2 text-sm text-muted-foreground font-mono">
					<span class="text-accent">{ "~" }</span>
					<span>{ p.Company }</span>
					<span class="text-muted">{ "·" }</span>
					<span>{ p.Location }</span>
				</div>
				<div class="flex items-center gap-4 mt-2">
					for _, link := range p.Links {
						<a
							href={ templ.SafeURL(link.URL) }
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex items-center gap-1.5 text-sm font-mono text-accent no-underline"
						>
							@LinkIcon(link.Label)
							<span>{ link.Label }</span>
						</a>
					}
				</div>
			</div>
		</div>
	</section>
}

templ LinkIcon(label string) {
	switch label {
	case "Email":
		<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect width="20" height="16" x="2" y="4" rx="2"/>
			<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
		</svg>
	case "Phone", "Call":
		<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
		</svg>
	case "SMS":
		<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
		</svg>
	}
}
