package homepage

import "cv-website/model"

templ EducationSection(edu []model.Education) {
	<section id="education" class="section-container py-12">
		<div class="section-heading">
			<span class="text-accent">{ ">" }</span>
			<h2 class="font-mono text-lg font-semibold text-foreground">Education</h2>
			<div class="section-heading-line"></div>
		</div>
		<div class="flex flex-col gap-8">
			for _, e := range edu {
				<div class="card-base flex flex-col sm:flex-row gap-6 items-start">
					if e.Image != "" {
						<div class="shrink-0">
							<div x-data="{ open: false }" class="relative">
								<button
									@click="open = true"
									class="block rounded-md border border-border overflow-hidden cursor-zoom-in hover:border-accent/60 transition-colors"
								>
									<img
										src={ e.Image }
										alt={ e.Degree }
										width="192"
										height="128"
										class="w-48 h-32 object-cover block"
										loading="lazy"
									/>
								</button>
								<div
									x-show="open"
									x-cloak
									x-transition.opacity
									class="fixed inset-0 z-200 flex items-center justify-center bg-black/70 p-4 overscroll-contain"
									@click.self="open = false"
									@keydown.escape.window="open = false"
								>
									<button
										@click="open = false"
										class="absolute top-4 right-4 p-2 text-white/70 hover:text-white transition-colors"
										aria-label="Close"
									>
										<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
											<path d="M18 6L6 18"/><path d="M6 6l12 12"/>
										</svg>
									</button>
									<img
										src={ e.Image }
										alt={ e.Degree }
										class="max-w-full max-h-[90vh] rounded-md"
									/>
								</div>
							</div>
						</div>
					}
					<div class="flex flex-col gap-3">
						<div>
							<div class="flex items-center gap-2 mb-1">
								@InstitutionIcon(e.Institution)
								<span class="text-sm font-mono text-muted-foreground uppercase tracking-wider">{ e.Institution }</span>
							</div>
							<h3 class="font-semibold text-foreground">{ e.Degree }</h3>
							<p class="text-sm text-muted-foreground">{ e.Institution }</p>
						</div>
						if e.VerifyURL != "" {
							<a
								href={ e.VerifyURL }
								target="_blank"
								rel="noopener noreferrer"
								class="link text-base font-mono inline-flex items-center gap-1"
							>
								<span>{ "→" }</span>
								<span>Verify credential</span>
							</a>
						}
					</div>
				</div>
			}
		</div>
	</section>
}

templ InstitutionIcon(institution string) {
	if institution == "Red Hat, Inc." {
		<svg class="w-5 h-auto" viewBox="0 0 190.35 144" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
			<path d="M126.97 83c12.5 0 30.6-2.6 30.6-17.47a14 14 0 0 0-.3-3.42l-7.45-32.35c-1.72-7.12-3.23-10.35-15.73-16.6C124.4 8.2 103.25 0 97 0c-5.8 0-7.5 7.5-14.44 7.5-6.68 0-11.64-5.6-17.9-5.6-6 0-9.9 4.1-12.92 12.5 0 0-8.4 23.72-9.5 27.16a6.43 6.43 0 0 0-.2 1.94c0 9.22 36.3 39.45 84.93 39.45m32.53-11.38c1.73 8.2 1.73 9.05 1.73 10.13 0 14-15.74 21.77-36.43 21.77C78.04 103.5 37.08 76.1 37.08 58a18.45 18.45 0 0 1 1.5-7.34C21.8 51.5 0 54.5 0 73.72 0 105.2 74.6 144 133.65 144c45.28 0 56.7-20.48 56.7-36.65 0-12.72-11-27.16-30.83-35.78" fill="#e00"/>
			<path d="M159.5 71.57c1.73 8.2 1.73 9.05 1.73 10.13 0 14-15.74 21.77-36.43 21.77C78.04 103.5 37.08 76.1 37.08 58a18.45 18.45 0 0 1 1.5-7.34l3.67-9.06a6.43 6.43 0 0 0-.22 1.9c0 9.22 36.3 39.45 84.94 39.45 12.5 0 30.6-2.58 30.6-17.46a14 14 0 0 0-.3-3.43z" fill="#000"/>
		</svg>
	} else if institution == "Huawei Technologies" {
		<svg class="w-5 h-5" viewBox="-240 -260 610 500" aria-hidden="true" fill="none">
			<g transform="translate(-21, 139)">
				<path fill="#CF0A2C" d="M28.1-390.2c-8 0.7-29.4 5.6-29.4 5.6h0c-48.4 12.5-59.9 56.5-59.9 56.5-2.4 7.4-3.4 15-3.8 22.1v9.7c0.6 15 4 26.2 4 26.2C-44.8-198.3 34.7-80.4 51.8-55.7c1.2 1.2 2.2 0.8 2.2 0.8 1.8-0.5 1.7-2.3 1.7-2.3l0 0C82.1-320.4 28.1-390.2 28.1-390.2L28.1-390.2z M115.1-390.2c0 0-54.2 69.8-27.9 333.2h0c0.2 1.7 1.4 2 1.4 2 1.8 0.7 2.7-1 2.7-1l0 0c17.5-25.4 96.6-142.6 112.7-214.1 0 0 8.7-34.6 0.3-58 0 0-12-44.6-60.5-56.4C143.9-384.5 130-388.1 115.1-390.2L115.1-390.2z M-134.9-311.1c0 0-46.2 43.8-48.4 90.2h0v7c0 0.5 0.1 1.1 0.1 1.6 2 37.4 30.2 59.6 30.2 59.6C-107.7-108.4 2.2-52.6 27.7-39.9c0.4 0.1 1.7 0.6 2.5-0.4 0 0 0.4-0.3 0.6-0.9v-1.2c0-0.1-0.1-0.1-0.1-0.2h0C-39.2-195.3-134.9-311.2-134.9-311.1L-134.9-311.1z M278-311.1c0 0-95.4 115.5-165.3 268l0 0c0 0-0.8 1.8 0.5 2.9 0 0 0.4 0.3 0.9 0.4h1c0.2-0.1 0.4-0.1 0.5-0.2v0c26.2-13 135.3-68.5 180.5-112.5 0 0 28.6-23 30.1-59.9C329.6-263.7 278-311.2 278-311.1L278-311.1z M363.9-159.5c0 0-155.5 83.5-235.9 137.7l0 0l0 0c0 0-1.5 1-0.9 2.7 0 0 0.8 1.4 1.9 1.4v0c28.8 0.1 137.8 0.2 140.5-0.3 0 0 14.1-0.6 31.5-7.3 0 0 38.8-12.3 58.9-56.3 0 0 9.2-18.4 9.3-44.3v-1.1C369.1-136.9 367.7-148 363.9-159.5L363.9-159.5z M-220.8-159.1c-14.2 43.8 4.9 79.1 4.9 79.2 19.9 41.9 57.7 54.7 57.7 54.7 17.5 7.2 35 7.7 35 7.7 2.7 0.5 108.8 0.1 137.2-0.1 1.2 0 1.9-1.2 1.9-1.2 0.1-0.1 0.2-0.3 0.2-0.4v-1.1c-0.2-0.7-0.9-1.3-0.9-1.3l0 0C-65.1-75.8-220.8-159.1-220.8-159.1L-220.8-159.1z M10.8-4.2l-183 6.4c19.8 35.4 53.3 62.9 88.1 54.4 24-6 78.4-44 96.4-56.8l-0.1-0.1c1.4-1.3 0.9-2.3 0.9-2.3C12.7-4.1 10.8-4.1 10.8-4.2L10.8-4.2z M132-4.1L132-4.1c0 0.1-1.6 0.3-2.1 1.5 0 0-0.4 1.6 0.7 2.5l0 0c17.5 12.6 70.6 49.7 96.2 56.9 0 0 3.9 1.3 10.4 1.6h3.9c17.1-0.6 47-9.4 74.1-56L132-4.1z"/>
			</g>
		</svg>
	} else {
		<svg class="w-5 h-5 text-accent shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
		</svg>
	}
}
