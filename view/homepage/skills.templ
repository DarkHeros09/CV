package homepage

import "cv-website/model"

templ SkillsSection(skills []model.SkillGroup) {
	<section id="skills" class="section-container py-12">
		<div class="section-heading">
			<span class="text-accent">{ ">" }</span>
			<h2 class="font-mono text-lg font-semibold text-foreground">skills</h2>
			<div class="section-heading-line"></div>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			for _, group := range skills {
				<div class="skill-card">
					<h3 class="font-mono text-sm text-accent mb-3 uppercase tracking-wider">
						{ group.Category }
					</h3>
					<div class="flex flex-col gap-1.5">
						for _, item := range group.Items {
							<div class="flex items-center gap-2 px-2 py-1 rounded hover:bg-border/30 transition-colors">
								@SkillIcon(item)
								<span class="text-sm text-muted-foreground">{ item }</span>
							</div>
						}
					</div>
				</div>
			}
		</div>
	</section>
}
