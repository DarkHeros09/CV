package homepage

templ SkillIcon(name string) {
	switch name {
	case "Linux":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 20 21"><path fill="currentColor" d={ linuxPath }/></svg>
	case "Docker":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16"><path fill="currentColor" d={ dockerPath }/></svg>
	case "Kubernetes":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16"><path fill="currentColor" fill-rule="evenodd" d={ kubernetesPath } clip-rule="evenodd"/></svg>
	case "Flutter":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 128 128"><g fill="currentColor"><path d="M12.3 64.2L76.3 0h39.4L32.1 83.6zM76.3 128h39.4L81.6 93.9l34.1-34.8H76.3L42.2 93.5z"/></g><path fill="currentColor" d="M81.6 93.9l-20-20-19.4 19.6 19.4 19.6z"/><path fill="currentColor" d="M115.7 128L81.6 93.9l-20 19.2L76.3 128z"/></svg>
	case "Golang":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="currentColor" d={ golangPath }/></svg>
	case "PowerShell":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="currentColor" d={ powershellPath }/></svg>
	case "PostgreSQL":
		<svg class="w-4 h-4 shrink-0" viewBox="-4 0 264 264"><path fill="currentColor" d={ postgresPath }/></svg>
	case "Firebase":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 600 600"><path fill="currentColor" d="M213.918 560.499c23.248 9.357 48.469 14.909 74.952 15.834 35.84 1.252 69.922-6.158 100.391-20.234-36.537-14.355-69.627-35.348-97.869-61.448-18.306 29.31-45.382 52.462-77.474 65.848Z"/><path fill="currentColor" d="M291.389 494.66c-64.466-59.622-103.574-145.917-100.269-240.568.108-3.073.27-6.145.46-9.216a166.993 166.993 0 0 0-36.004-5.241 167.001 167.001 0 0 0-51.183 6.153c-17.21 30.145-27.594 64.733-28.888 101.781-3.339 95.611 54.522 179.154 138.409 212.939 32.093-13.387 59.168-36.51 77.475-65.848Z"/><path fill="currentColor" d="M291.39 494.657c14.988-23.986 24.075-52.106 25.133-82.403 2.783-79.695-50.792-148.251-124.942-167.381-.19 3.071-.352 6.143-.46 9.216-3.305 94.651 35.803 180.946 100.269 240.568Z"/><path fill="currentColor" d="M308.231 20.858C266 54.691 232.652 99.302 212.475 150.693c-11.551 29.436-18.81 61.055-20.929 94.2 74.15 19.13 127.726 87.686 124.943 167.38-1.058 30.297-10.172 58.39-25.134 82.404 28.24 26.127 61.331 47.093 97.868 61.447 73.337-33.9 125.37-106.846 128.383-193.127 1.952-55.901-19.526-105.724-49.875-147.778-32.051-44.477-159.5-194.36-159.5-194.36Z"/></svg>
	case "DBML":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="currentColor" d={ dbmlPath }/></svg>
	case "SQL":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 32 32"><polygon fill="currentColor" points="24 21 24 9 22 9 22 23 30 23 30 21 24 21"/><path fill="currentColor" d={ sqlPath }/></svg>
	case "Git":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 128 128"><path fill="currentColor" d="M124.737 58.378L69.621 3.264c-3.172-3.174-8.32-3.174-11.497 0L46.68 14.71l14.518 14.518c3.375-1.139 7.243-.375 9.932 2.314 2.703 2.706 3.461 6.607 2.294 9.993l13.992 13.993c3.385-1.167 7.292-.413 9.994 2.295 3.78 3.777 3.78 9.9 0 13.679a9.673 9.673 0 01-13.683 0 9.677 9.677 0 01-2.105-10.521L68.574 47.933l-.002 34.341a9.708 9.708 0 012.559 1.828c3.778 3.777 3.778 9.898 0 13.683-3.779 3.777-9.904 3.777-13.679 0-3.778-3.784-3.778-9.905 0-13.683a9.65 9.65 0 013.167-2.11V47.333a9.581 9.581 0 01-3.167-2.111c-2.862-2.86-3.551-7.06-2.083-10.576L41.056 20.333 3.264 58.123a8.133 8.133 0 000 11.5l55.117 55.114c3.174 3.174 8.32 3.174 11.499 0l54.858-54.858a8.135 8.135 0 00-.001-11.501z"/></svg>
	case "GitHub":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 20 20"><path fill="currentColor" fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 10 4.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 20 10.017C20 4.484 15.522 0 10 0z"/></svg>
	case "Cloud Storage":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="currentColor" d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/></svg>
	case "Figma":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 32 32" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M16 16c0-2.209 1.791-4 4-4s4 1.791 4 4-1.791 4-4 4-4-1.791-4-4z"/><path fill-rule="evenodd" clip-rule="evenodd" d="M8 24c0-2.209 1.791-4 4-4h4v4c0 2.209-1.791 4-4 4s-4-1.791-4-4z"/><path fill-rule="evenodd" clip-rule="evenodd" d="M16 4v8h4c2.209 0 4-1.791 4-4s-1.791-4-4-4h-4z"/><path fill-rule="evenodd" clip-rule="evenodd" d="M8 8c0 2.209 1.791 4 4 4h4V4h-4C9.791 4 8 5.791 8 8z"/><path fill-rule="evenodd" clip-rule="evenodd" d="M8 16c0 2.209 1.791 4 4 4h4v-8h-4C9.791 12 8 13.791 8 16z"/></svg>
	case "Frontend Development":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="currentColor" d="M14.6 16.6l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4zm-5.2 0L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4z"/></svg>
	case "Backend Development":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 32 32"><circle fill="currentColor" cx="23" cy="23" r="1"/><rect fill="currentColor" x="8" y="22" width="12" height="2"/><circle fill="currentColor" cx="23" cy="9" r="1"/><rect fill="currentColor" x="8" y="8" width="12" height="2"/><path fill="currentColor" d="M26 14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2v4H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-2v-4h2zM6 6h20v6H6zm20 20H6v-6h20zm-4-8H10v-4h12z"/></svg>
	case "Clean Architecture":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z"/></svg>
	case "TDD":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 1 1 4 0H9zm1 7l2 2 4-4"/></svg>
	case "CI/CD":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6m12-4a9 9 0 0 1-15 6.7L3 16"/></svg>
	case "Virtualization":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16"><path fill="currentColor" d={ virtualizationPath }/></svg>
	case "IoT":
		<svg class="w-4 h-4 shrink-0" viewBox="0 0 32 32"><path fill="currentColor" d={ iotPath }/></svg>
	default:
		<span class="text-accent text-xs font-mono">{ "·" }</span>
	}
}
